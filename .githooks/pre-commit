#!/bin/sh
# Runs `make check` when a commit touches Go code. `make setup` installs it.
# Skip it for one commit with `git commit --no-verify`.

if git diff --cached --name-only | grep -qE '\.go$|(^|/)go\.(mod|sum)$|^\.golangci\.yml$'; then
	echo "pre-commit: running make check (skip with git commit --no-verify)"
	exec make check
fi
