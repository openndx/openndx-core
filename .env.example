# OpenNDX - Local Development Environment
# Generated for local development and testing

# Environment Configuration
ENVIRONMENT=local
LOG_LEVEL=info
LOG_FORMAT=text

# Build Configuration
BUILD_VERSION=dev
BUILD_TIME=2025-09-15T14:30:00Z
GIT_COMMIT=local

# Service Ports
PORT_PDP=8082
PORT_CE=8081
PORT_PB=8083
PORT_OE=4000
PORT_AUDIT=3001
# Must stay in sync with CONSENT_PORTAL_URL below — that's the port ThunderID's
# CONSENT_PORTAL client is registered with (redirect URIs, CORS), not just
# where the container happens to publish.
PORT_CONSENT_PORTAL=5173

# Service Configuration
CONSENT_PORTAL_URL=http://localhost:5173

# Database Configuration
# These match the bundled postgres service in docker-compose.yml.
PORT_DB=5432
DB_HOST=postgres
DB_PORT=5432
DB_USER=exchange
DB_PASSWORD=exchange
DB_SSLMODE=disable
# Per-service database names (created by init-db.sql)
DB_NAME_PDP=pdp
DB_NAME_CE=consent_engine
DB_NAME_OE=orchestration_engine
# Auto-create tables on startup
RUN_MIGRATION=true

# Telemetry
OTEL_METRICS_EXPORTER=prometheus

# IDP Configuration
# IDP_PUBLIC_URL is ThunderID's own public URL (thunderid/deployment.yaml hardcodes
# the same value as server.public_url). Must be https:// to match deployment.yaml —
# thunderid-setup's TLS listener rejects plain http. compose.yml feeds it to PDP/CE
# as IDP_ISSUER directly (there's no separate IDP_ISSUER var to set here), since
# ThunderID issues tokens with iss == its public URL.
#
# consent-engine's verifier validates issuer, audience, and client_id when each is
# set, extracts the email claim, and is otherwise IdP-agnostic.
IDP_PUBLIC_URL=https://localhost:8090
# The OE resource server identifier declared in thunderid/bootstrap/resource.yaml —
# tokens requested with resource=http://api.openndx.local carry this as `aud`. Used
# by PDP only.
IDP_AUDIENCE=http://api.openndx.local
# Expected `aud` for citizen consent-portal tokens — deliberately separate from
# IDP_AUDIENCE above so a token minted for one API can't be replayed against the
# other. Set to the Consent Portal's own client ID (CONSENT_PORTAL_CLIENT_ID),
# not a resource identifier: the portal's OIDC client only ever requests
# `openid profile email` — no `resource` param, no permission scope — and per
# ThunderID's ResolveAudienceBinding (resourceindicators.go), a token request
# with neither gets `aud` set to the requesting client_id, not a resource
# server identifier. thunderid/bootstrap/resource.yaml still declares a proper
# "Consent Engine Resource Server" (http://consent.openndx.local) for a future
# fix where the portal actually requests `resource=...`; until then this is
# the value that's actually in the token.
CONSENT_ENGINE_AUDIENCE=CONSENT_PORTAL
# consent-engine reads this as IDP_CLIENT_ID to validate the Consent Portal's tokens;
# must match the clientId in thunderid/bootstrap/application.yaml.
CONSENT_PORTAL_CLIENT_ID=CONSENT_PORTAL
# thunderid and consent-engine share the openndx-network, so the service name
# resolves directly — no host.docker.internal/extra_hosts needed here.
IDP_JWKS_URL=https://thunderid:8090/oauth2/jwks
# Dev-only: skip TLS verification on the JWKS fetch. ThunderID's cert here is a
# locally-generated self-signed one, so this must stay true for local dev. Leave
# false (or unset) once fronted by a real cert in a shared/production environment.
IDP_JWKS_INSECURE_SKIP_VERIFY=true
# Token claim consent-engine compares against a consent record's owner_id
# (default "sub"). OE seeds owner_id from the query's `nic` argument
# (foundationalIdArgName), so this must be "nic" for a citizen's approval to
# match — see thunderid/bootstrap/users.yaml's "Citizen" user_type and
# dev/README.md for the matching mock-provider NIC to test with.
IDP_SUBJECT_CLAIM=nic

# ThunderID (local dev IdP) bootstrap
# Secret for the sample data-consumer M2M client that thunderid-setup provisions
# via thunderid/bootstrap/resource.yaml. Local-dev only — change if this ever
# reaches a shared environment.
DATA_CONSUMER_CLIENT_SECRET=devsecret

# Audit Service Configuration (Optional)
# If omitted or ENABLE_AUDIT=false, auditing is disabled and services run normally.
# AUDIT_SERVICE_URL=http://localhost:3001
# ENABLE_AUDIT=true
# ARGUS_API_KEY=test-audit-token

