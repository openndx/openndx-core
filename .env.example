# OpenNDX - Local Development Environment
#
# Optional: compose.yml already defaults every variable below to the value shown,
# so `docker compose up --build` works without a .env file. Copy this to .env
# (`cp .env.example .env`) and edit only what you need to override.
#
# All secrets default to 1234 — local dev only, change them before this reaches
# any shared environment.

# Common (all OpenNDX services)
ENVIRONMENT=local
BUILD_VERSION=dev
BUILD_TIME=
GIT_COMMIT=local
OTEL_METRICS_EXPORTER=prometheus

# PostgreSQL
# DB_PORT is the host port; services always reach postgres on 5432 inside the
# compose network. DB_USER/DB_PASSWORD only take effect on a fresh postgres-data volume.
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_SSLMODE=disable
RUN_MIGRATION=true

# ThunderID (IdP)
# IDP_PUBLIC_URL is the `iss` of every token; must match server.public_url in
# thunderid/deployment.yaml. IDP_JWKS_URL is reached from inside the compose network.
IDP_PUBLIC_URL=http://localhost:8090
IDP_JWKS_URL=http://thunderid:8090/oauth2/jwks
IDP_ADMIN_PASSWORD=1234
# Secret of the sample DATA_CONSUMER M2M client (thunderid/bootstrap/application.yaml).
DATA_CONSUMER_CLIENT_SECRET=1234

# Policy Decision Point
PDP_PORT=8082
# Must match a database created by init-db.sql.
DB_NAME_PDP=pdp
# OE resource server identifier (thunderid/bootstrap/resource.yaml).
IDP_AUDIENCE=http://api.openndx.local

# Consent Engine
CE_PORT=8081
DB_NAME_CE=consent_engine
# Kept separate from IDP_AUDIENCE so a token minted for one API can't be replayed
# against the other; the portal requests no `resource`, so ThunderID sets `aud`
# to the requesting client_id.
CONSENT_ENGINE_AUDIENCE=CONSENT_PORTAL
# Token claim matched against a consent's owner_id. OE seeds owner_id from the
# query's `nic` argument — see thunderid/bootstrap/users.yaml and dev/README.md.
IDP_SUBJECT_CLAIM=nic

# Consent Portal
# CONSENT_PORTAL_PORT and CONSENT_PORTAL_URL must stay in sync with each other and
# with the allowed origins in thunderid/bootstrap/cors.yaml.
CONSENT_PORTAL_PORT=5173
CONSENT_PORTAL_URL=http://localhost:5173
# Must match thunderid/bootstrap/application.yaml.
CONSENT_PORTAL_CLIENT_ID=CONSENT_PORTAL

# Orchestration Engine
OE_PORT=4000
DB_NAME_OE=orchestration_engine

# Portal Backend
PB_PORT=8083
DB_NAME_PB=portal_backend
# Must match thunderid/bootstrap/application.yaml.
NDX_CLI_CLIENT_ID=NDX_CLI
# Only needs to be non-empty; PB's IdP admin calls don't work against ThunderID yet.
IDP_CLIENT_SECRET=1234
CORS_ALLOWED_ORIGINS=*
AUTHORIZATION_MODE=fail_open_admin_system
AUTHORIZATION_STRICT_MODE=false

# Audit Service (optional; OE and PB degrade gracefully if it's unreachable)
AUDIT_PORT=3001
DB_NAME_AUDIT=audit
AUDIT_SERVICE_URL=http://audit-service:3001
ARGUS_API_KEY=1234
